# Reproducible Nitro EIF build for sekisho, adapted from
# an internal sibling project's EIF build (itself the generic
# unconfirmedlabs/nautilus-rust EIF build shape). StageX (stagex.tools) base
# images, all pinned by sha256 digest -- "a full source bootstrapped,
# deterministic, and hermetic build toolchain" -- plus a normalized initramfs
# (SOURCE_DATE_EPOCH=0, sorted+reproducible cpio) and AWS's `eif_build`
# producing nitro.eif + nitro.pcrs together.
#
# CRITICAL DIFFERENCE from the sibling project this was adapted from: no secret
# build-args are baked into this image, and there is no equivalent of its
# Seal-related ARGs. All
# runtime secrets (provider API keys, caller keys, policy JSON) arrive at boot
# over VSOCK from argonaut -- see eif/run.sh and docs/SPEC.md sec 4/5. The only
# thing baked in here that isn't the app binary itself is the outbound HTTPS
# allowlist (enclave/eif/bridge-config.json), which is *not* a secret -- it's
# public policy that we deliberately want PCR-visible so an operator can't
# silently widen which domains the gateway may reach without changing PCR0.
# (PCR0 -- not PCR2: this build passes a single ramdisk, so eif_build leaves
# PCR2 a constant. See docs/SPEC.md, "What the PCRs actually measure".)
#
# argonaut (github.com/unconfirmedlabs/argonaut) is built from source here too,
# pinned to a fixed commit, and included in the image for VSOCK<->TCP bridging
# and one-shot boot config delivery (replaces the socat-based wiring used by
# the Nautilus template and the sibling project).

FROM stagex/core-binutils@sha256:f2d3bf6104db0d5ac39ca155c0241bfea2516a6829e3b4fd657cf9ba5b625478 AS core-binutils
FROM stagex/core-ca-certificates@sha256:d135f1189e9b232eb7316626bf7858534c5540b2fc53dced80a4c9a95f26493e AS core-ca-certificates
FROM stagex/core-gcc@sha256:964ffd3793c5a38ca581e9faefd19918c259f1611c4cbf5dc8be612e3a8b72f5 AS core-gcc
FROM stagex/core-git@sha256:6b3e0055f6aeaa8465f207a871db2c63a939cd7406113e9d769ff3b37239f3d0 AS core-git
FROM stagex/core-zlib@sha256:06f5168e20d85d1eb1d19836cdf96addc069769b40f8f0f4a7a70b2f49fc18f8 AS core-zlib
FROM stagex/core-libffi@sha256:64d087343541401271cf9fec6b7bd788040c72a16918748ae36c171e53e94002 AS core-libffi
FROM stagex/core-llvm@sha256:583ecda677f51b69857f8027dfc58f4a931d1adc4d16214870a373505210d973 AS core-llvm
FROM stagex/core-libcxx@sha256:733ddf3bf6a47ba39578bec31d30804db134fa72482e8dbf4fcf288788d8a5b4 AS core-libcxx
FROM stagex/core-libcxxabi@sha256:88e66348a0eb2b1c0a321aaac138aef4ccc4bbd13a16ffd1de0231d5506f66b3 AS core-libcxxabi
FROM stagex/core-openssl@sha256:d6487f0cb15f4ee02b420c717cb9abd85d73043c0bb3a2c6ce07688b23c1df07 AS core-openssl
FROM stagex/core-curl@sha256:bc8bab43d96a9167fbb85022ea773644a45ef335e7a9b747f203078973fa988e AS core-curl
FROM stagex/core-rust@sha256:afd1cad50f1beff37d41d756e4ebf606b7a100119e96d3c1b140fa6b27386034 AS core-rust
FROM stagex/core-musl@sha256:d9af23284cca2e1002cd53159ada469dfe6d6791814e72d6163c7de18d4ae701 AS core-musl
FROM stagex/core-libunwind@sha256:c76fcc66148b19230247b7cdba06040dbe2f47aa19d7a4be4d430db15d47e4b8 AS core-libunwind
FROM stagex/core-pkgconf@sha256:52624a89bb8cc684bc0391fcb7770ded2bbcb281e84bdb68a31fce127439fd7b AS core-pkgconf
FROM stagex/core-busybox@sha256:637b1e0d9866807fac94c22d6dc4b2e1f45c8a5ca1113c88172e0324a30c7283 AS core-busybox
FROM stagex/core-libzstd@sha256:5382c221194b6d0690eb65ccca01c720a6bd39f92e610dbc0e99ba43f38f3094 AS core-libzstd
FROM stagex/user-eif_build@sha256:935032172a23772ea1a35c6334aa98aa7b0c46f9e34a040347c7b2a73496ef8a AS user-eif_build
FROM stagex/user-gen_initramfs@sha256:a87e9a3fa8468d2e08b5abb0a6da4c7a11df22273e2c526cb22e6b131151def8 AS user-gen_initramfs
FROM stagex/user-linux-nitro@sha256:aa1006d91a7265b33b86160031daad2fdf54ec2663ed5ccbd312567cc9beff2c AS user-linux-nitro
FROM stagex/user-cpio@sha256:9c8bf39001eca8a71d5617b46f8c9b4f7426db41a052f198d73400de6f8a16df AS user-cpio
FROM stagex/user-nit@sha256:60b6eef4534ea6ea78d9f29e4c7feb27407b615424f20ad8943d807191688be7 AS user-nit

# --- argonaut: static Go binary, built separately and pinned by commit.
# StageX does not (yet) publish a Go toolchain package, so this one stage
# breaks from the pure-StageX chain; it's still fully digest-pinned and its
# output is reproducible independently (CGO_ENABLED=0, -trimpath, -buildvcs=false,
# no embedded build id -- the same flags argonaut's own Makefile `build` target
# uses). If StageX ships a core-go package later, this stage should move onto
# it to close the gap. See docs/research/local-patterns.md / nautilus.md for
# why the rest of the pipeline stays StageX-only.
FROM golang@sha256:91eda9776261207ea25fd06b5b7fed8d397dd2c0a283e77f2ab6e91bfa71079d AS argonaut-src
RUN apk add --no-cache git ca-certificates
ARG ARGONAUT_REV=8f5d1ba937fb2020b6572cc834faa4ceaf939d1c
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GOARCH=amd64
ENV GOFLAGS=-mod=readonly
ENV SOURCE_DATE_EPOCH=0
RUN git clone https://github.com/unconfirmedlabs/argonaut.git /src/argonaut \
	&& cd /src/argonaut \
	&& git checkout --quiet "$ARGONAUT_REV"
WORKDIR /src/argonaut
RUN go build -mod=readonly -trimpath -buildvcs=false -tags=netgo,osusergo \
	-ldflags="-s -w -buildid=" -o /out/argonaut .

FROM scratch AS base
COPY --from=core-busybox . /
COPY --from=core-musl . /
COPY --from=core-libunwind . /
COPY --from=core-openssl . /
COPY --from=core-curl . /
COPY --from=core-zlib . /
COPY --from=core-ca-certificates . /
COPY --from=core-libzstd . /
COPY --from=core-binutils . /
COPY --from=core-pkgconf . /
COPY --from=core-git . /
COPY --from=core-rust . /
COPY --from=user-gen_initramfs . /
COPY --from=user-eif_build . /
COPY --from=core-llvm . /
COPY --from=core-libcxx . /
COPY --from=core-libcxxabi . /
COPY --from=core-libffi . /
COPY --from=core-gcc . /
COPY --from=user-cpio . /
COPY --from=user-linux-nitro /bzImage .
COPY --from=user-linux-nitro /linux.config .

FROM base AS build
WORKDIR /workspace
COPY . .

ENV OPENSSL_STATIC=true
ENV SOURCE_DATE_EPOCH=0
ENV TARGET=x86_64-unknown-linux-musl
ENV RUSTFLAGS="-C target-feature=+crt-static -C relocation-model=static -C target-cpu=x86-64 --remap-path-prefix=/workspace=/workspace"
ARG ENCLAVE_PACKAGE=sekisho-enclave
ARG ENCLAVE_BIN=sekisho-enclave

# StageX Rust links build scripts and final musl binaries through libunwind
# names that are not all present in the runtime layer (same fixup as
# the sibling project's EIF build).
RUN ln -sf /usr/lib/gcc/x86_64-linux-musl/13.1.0/libgcc_eh.a /usr/lib/libunwind.a \
	&& ln -sf libunwind.so.1 /usr/lib/libunwind.so \
	&& ln -sf libunwind.so.1 /usr/lib/libunwind.so.8 \
	&& ln -sf libunwind.so.1 /lib64/libunwind.so \
	&& ln -sf libunwind.so.1 /lib64/libunwind.so.8
RUN cargo build --locked --release --target "$TARGET" -p "$ENCLAVE_PACKAGE"

WORKDIR /build_cpio
ENV KBUILD_BUILD_TIMESTAMP=1
# Create ONLY the top-level directory. The base layers below own /bin, /etc
# and friends: pre-creating initramfs/bin as a real directory makes BuildKit
# fail with "cannot replace to directory ... with file" when core-musl's /bin
# symlink lands on top of it. Directories we add ourselves are created after
# the base layers, below.
RUN mkdir initramfs
COPY --from=core-busybox . initramfs
COPY --from=core-musl . initramfs
COPY --from=core-ca-certificates /etc/ssl/certs initramfs/etc/ssl/certs
COPY --from=user-nit /bin/init initramfs/init
COPY --from=argonaut-src /out/argonaut initramfs/bin/argonaut
RUN cp "/workspace/target/${TARGET}/release/${ENCLAVE_BIN}" initramfs/sekisho-enclave
RUN cp /workspace/eif/run.sh initramfs/run.sh
RUN mkdir -p initramfs/etc/argonaut
# Outbound allowlist + inbound bridge topology: not a secret, deliberately
# baked in so it's measured into PCR0 (see header comment and eif/run.sh).
RUN cp /workspace/eif/bridge-config.json initramfs/etc/argonaut/bridge-config.json
RUN chmod +x initramfs/sekisho-enclave initramfs/run.sh initramfs/bin/argonaut

RUN <<-EOF
	set -eux
	cd initramfs
	find . -exec touch -hcd "@0" "{}" + -print0 \
	| sort -z \
	| cpio \
		--null \
		--create \
		--verbose \
		--reproducible \
		--format=newc \
	| gzip --best --no-name \
	> /build_cpio/rootfs.cpio
EOF

WORKDIR /build_eif
RUN <<-EOF
	set -eux
	RAMDISK_SIZE=$(wc -c < /build_cpio/rootfs.cpio)
	eif_build \
		--kernel /bzImage \
		--kernel_config /linux.config \
		--ramdisk /build_cpio/rootfs.cpio \
		--pcrs_output /nitro.pcrs \
		--output /nitro.eif \
		--cmdline "reboot=k initrd=0x2000000,${RAMDISK_SIZE} root=/dev/ram0 panic=1 pci=off nomodules console=ttyS0 i8042.noaux i8042.nomux i8042.nopnp i8042.dumbkbd nit.target=/run.sh"
EOF

# Default (final) stage: `make eif`'s plain `docker build` (no --target) picks
# this up, giving out/nitro.eif + out/nitro.pcrs + out/rootfs.cpio + the exact
# argonaut binary the enclave is running (out/argonaut-host), so the host-side
# `argonaut host` process launched by scripts/expose_enclave.sh is guaranteed
# to be byte-identical to the one measured inside the enclave.
FROM scratch AS package
COPY --from=build /nitro.eif .
COPY --from=build /nitro.pcrs .
COPY --from=build /build_cpio/rootfs.cpio .
COPY --from=argonaut-src /out/argonaut ./argonaut-host
